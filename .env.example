# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o git.

# Obrigatório em produção: gere com  python -c "import secrets; print(secrets.token_urlsafe(48))"
OCUPABOT_SEGREDO=troque-este-valor

# Banco (SQLite por padrão; Postgres também funciona: postgresql+psycopg://usuario:senha@host/banco)
OCUPABOT_BANCO_URL=sqlite:///./data/ocupabot.db

# Nome exibido nas mensagens do bot
OCUPABOT_NOME_CLINICA=Clínica Exemplo

# Cookies só por HTTPS (ligue quando houver proxy com TLS na frente)
OCUPABOT_COOKIE_SEGURO=false

# Documentação interativa da API em /docs (deixe desligado em produção)
OCUPABOT_DOCS_ATIVO=false

# ---- WhatsApp -------------------------------------------------------------
# console = só registra no log (desenvolvimento) | waha = WAHA (não oficial)
OCUPABOT_CANAL=console
OCUPABOT_WAHA_URL=http://waha:3000
OCUPABOT_WAHA_SESSAO=default
OCUPABOT_WAHA_API_KEY=
# Token que o WAHA envia no cabeçalho X-Webhook-Token
OCUPABOT_WEBHOOK_TOKEN=

# O bot responde mensagens (nasce desligado)
OCUPABOT_BOT_ATIVO=false
# Modo teste: só os números listados conversam com o bot (nasce ligado)
OCUPABOT_MODO_TESTE=true
OCUPABOT_NUMEROS_TESTE=5511900000001,5511900000002

# Simulador do bot no painel (conversa sem WhatsApp)
OCUPABOT_SIMULADOR_ATIVO=true

# ---- Sistema de gestão externo (agenda oficial) ---------------------------
# nenhum = sem integração | simulador = sistema fictício em memória/banco
OCUPABOT_AGENDA_EXTERNA=simulador
